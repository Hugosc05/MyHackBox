generator client {
  provider = "prisma-client-js"
}

// Postgres (funciona en Vercel/serverless). Ver docs/DEPLOY_VERCEL.md.
// url       = conexión con POOLER (para el runtime serverless).
// directUrl = conexión DIRECTA (la usa el CLI de Prisma: db push / migrate).
// Sin pooler (Postgres local o Neon), pon el mismo valor en ambas.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  handle       String   @unique
  email        String?  @unique
  passwordHash String?
  xp           Int      @default(0)
  createdAt    DateTime @default(now())
  progress     UserLabProgress[]
  submissions  ChallengeSubmission[]
}

model UserLabProgress {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  labSlug          String
  status           String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  currentStepIndex Int       @default(0)
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  @@unique([userId, labSlug])
  @@index([userId, status])
}

model ChallengeSubmission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  labSlug     String
  isCorrect   Boolean  @default(false)
  submittedAt DateTime @default(now())

  @@index([userId, labSlug])
}
