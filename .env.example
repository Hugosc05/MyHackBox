# Postgres. En Vercel usa Vercel Postgres o Neon (gratis) y pega aquí su connection string.
# Local: mismo string de Neon, o un Postgres local (postgresql://user:pass@localhost:5432/myhackbox).
DATABASE_URL="postgresql://user:password@host:5432/myhackbox?sslmode=require"

# Secreto para firmar las cookies de sesión (HMAC). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambia-esto-por-un-valor-aleatorio-largo"
